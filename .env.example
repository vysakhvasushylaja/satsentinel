# Copy to .env and fill in. Placeholders only: never commit real values.
# SAMPLE_MODE=1 runs the full logic on local CSV files (DuckDB), no Zetaris or Nightshift needed.
SAMPLE_MODE=1
HOST=127.0.0.1
PORT=8000
SATSENTINEL_LOG_DIR=logs

# Zetaris AI Data Gateway (only used when SAMPLE_MODE=0)
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=your-zetaris-password
ZETARIS_JDBC_JAR=/path/to/ndp-jdbc-driver.jar

# Meterless Nightshift runtime (OpenAI-compatible). Without it the explanation falls back to a template.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3-ultra-550b-a55b
